# Copy to .env and adjust per machine (.env itself is git-ignored).

# --- Outbound proxy (optional) -------------------------------------------
# Used by compose for build args and the container environment: ccxt ->
# exchange data, pip during image builds.
#
# - Empty/unset  = direct internet (the common case on unproxied machines)
# - Proxied host = point containers at host.docker.internal, never
#   127.0.0.1 — inside a container, 127.0.0.1 is the container itself.
#
# TRADEAGENT_PROXY=http://host.docker.internal:10808

# --- Exchange selection (optional) ---------------------------------------
# ccxt exchange id for market data (default: binance). Set this when
# binance returns HTTP 451 "restricted location" from your network's
# exit region — e.g. binanceus, kraken, gate, okx all work via ccxt.
# CCXT universal symbols (BTC/USDT) keep working unchanged.
#
# TRADEAGENT_EXCHANGE=binanceus
